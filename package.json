{
  "name": "savextension",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Your Instagram saves, X bookmarks and Pinterest pins, together. A local-first library and browser extension.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "open": "node scripts/open-library.mjs",
    "prestart": "node scripts/package-extension.mjs",
    "start": "node server/index.mjs",
    "predev": "node scripts/package-extension.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package:extension": "node scripts/package-extension.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "predesktop": "node scripts/prepare-desktop.mjs",
    "desktop": "electron .",
    "predesktop:pack": "node scripts/prepare-desktop.mjs",
    "desktop:pack": "electron-builder --config electron-builder.config.cjs --dir",
    "predesktop:mac": "node scripts/prepare-desktop.mjs",
    "desktop:mac": "electron-builder --config electron-builder.config.cjs --mac dmg --arm64",
    "predesktop:win": "node scripts/prepare-desktop.mjs",
    "desktop:win": "electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "test:desktop": "node --test tests/desktop/*.test.mjs",
    "desktop:verify": "node scripts/verify-packaged.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.56.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "^27.1.0"
  },
  "main": "desktop/main.mjs",
  "productName": "saveXtension",
  "author": "ishantperiwal",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "linkify-it": "^6.1.0",
    "parse5": "^8.1.0",
    "tlds": "^1.261.0",
    "zod": "^4.6.7"
  }
}
