{
  "name": "savextension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Your Instagram saves and X bookmarks, together. A local-first library and browser extension.",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "open": "node scripts/open-library.mjs",
    "prestart": "node scripts/package-extension.mjs",
    "start": "node server/index.mjs",
    "predev": "node scripts/package-extension.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package:extension": "node scripts/package-extension.mjs",
    "reset-password": "node scripts/reset-password.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "jsdom": "^27.1.0"
  }
}
